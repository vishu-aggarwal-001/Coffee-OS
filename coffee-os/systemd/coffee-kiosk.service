[Unit]
Description=Coffee touchscreen (Cage + Chromium, full screen)
After=systemd-user-sessions.service plymouth-quit-wait.service coffee-hub.service
Wants=coffee-hub.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# -d: no window decorations, -s: allow switching to a text console (Ctrl+Alt+F2) for service
ExecStart=/usr/bin/cage -d -s -- /opt/coffee-os/kiosk/start-browser.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
