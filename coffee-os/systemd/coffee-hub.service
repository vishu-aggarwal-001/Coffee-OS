[Unit]
Description=Coffee Hub (screens, sales copy, alerts)
After=network.target
Wants=network.target

[Service]
Type=simple
User=coffeehub
Group=coffeehub
ExecStart=/usr/bin/python3 /opt/coffee-os/hub/coffee_hub.py --config /etc/coffee-hub/config.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
# Lock the service down; it only needs its data folder.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/coffee-hub
StateDirectory=coffee-hub

[Install]
WantedBy=multi-user.target
